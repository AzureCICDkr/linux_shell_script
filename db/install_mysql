#!/bin/bash
set -e

####################################
# 1. 패키지 업데이트
####################################
sudo apt update

####################################
# 2. MySQL Server 설치
####################################
sudo apt install -y mysql-server

####################################
# 3. MySQL bind-address 설정
####################################
MYSQL_CNF="/etc/mysql/mysql.conf.d/mysqld.cnf"

# bind-address 설정이 있으면 수정, 없으면 추가
if sudo grep -q "^bind-address" "$MYSQL_CNF"; then
    sudo sed -i 's/^bind-address.*/bind-address = 0.0.0.0/' "$MYSQL_CNF"
else
    sudo sed -i '/^\[mysqld\]/a bind-address = 0.0.0.0' "$MYSQL_CNF"
fi

####################################
# 4. MySQL 서비스 활성화 및 재시작
####################################
sudo systemctl enable mysql
sudo systemctl restart mysql

echo "⏳ MySQL 재기동 대기 중..."
sleep 5

####################################
# 5. MySQL 서비스 상태 확인
####################################
sudo systemctl status mysql --no-pager

####################################
# 6. DB / 유저 생성 여부 확인
####################################
echo
read -rp "📦 데이터베이스와 유저를 생성하시겠습니까? (y/n): " CREATE_DB

if [[ "$CREATE_DB" == "y" || "$CREATE_DB" == "Y" ]]; then
    read -rp "📘 생성할 DB(Schema) 이름: " DB_NAME
    read -rp "👤 생성할 유저명: " DB_USER
    read -rsp "🔐 유저 비밀번호: " DB_PASS
    echo

    sudo mysql <<EOF
CREATE DATABASE IF NOT EXISTS \`${DB_NAME}\`
  DEFAULT CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;

CREATE USER IF NOT EXISTS '${DB_USER}'@'%'
  IDENTIFIED WITH mysql_native_password
  BY '${DB_PASS}';

GRANT ALL PRIVILEGES ON \`${DB_NAME}\`.* TO '${DB_USER}'@'%';
FLUSH PRIVILEGES;
EOF

    echo "✅ DB 및 유저 생성 완료"
else
    echo "➡️ DB 생성 단계 건너뜀"
fi

####################################
# 7. 외부 접속 확인 안내
####################################
echo
echo "📌 외부 접속 허용 상태 확인:"
echo "   sudo ss -lntp | grep 3306"
echo
echo "📌 원격 접속 테스트 예시:"
echo "   mysql -u ${DB_USER} -p -h <SERVER_IP>"

